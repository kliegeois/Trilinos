+    impl_->part_interface  = part_interface_type();
+    impl_->block_tridiags  = block_tridiags_type();
+    impl_->a_minus_d       = amd_type();
+    impl_->work            = typename impl_type::vector_type_1d_view();
+    impl_->norm_manager    = norm_manager_type();
